{
  "name": "cv-generator",
  "version": "1.0.0",
  "description": "Static HTML resume site with PDF export capability",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "serve": "node server.js",
    "build": "node build.js && node generate-og-image.js",
